# Required. Get this from https://discord.com/developers/applications
# -> your application -> Bot -> Reset Token
DISCORD_TOKEN=

# Optional. Set this to your server's ID during development for
# near-instant slash command sync. Leave blank for a public/global
# deployment (global sync can take up to an hour to propagate).
DEV_GUILD_ID=

# Optional. Only relevant if you want classic "!command" style commands
# in addition to slash commands. Requires the message content intent
# enabled in the Developer Portal if set to true.
USE_PREFIX_COMMANDS=false
COMMAND_PREFIX=!

# Optional.
DB_PATH=data/bot.sqlite3
DEFAULT_VOLUME=0.3
MAX_QUEUE_SIZE=200
